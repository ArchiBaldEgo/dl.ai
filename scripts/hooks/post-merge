#!/bin/bash
# Git post-merge hook — срабатывает после git pull (когда был merge).
# Синхронизирует таблицу UpdateLog с новыми коммитами.
#
# Работает на хосте (где есть git), подключается к Docker-контейнеру web
# по имени контейнера (container_name=dl_ai_web в docker-compose.yml) — это
# не зависит от compose project name/cwd. В контейнере установлен git и
# примонтирован .git (volume `.: /app`), поэтому sync_update_log читает
# git log прямо в контейнере и видит свежий HEAD без перезапуска.

cd "$(git rev-parse --show-toplevel)"

CONTAINER="dl_ai_web"

# Надёжная проверка «контейнер запущен» по имени (без поиска compose-проекта).
if ! docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
    echo "[post-merge] Контейнер $CONTAINER не запущен — пропускаю синхронизацию UpdateLog"
    exit 0
fi

echo "[post-merge] Синхронизация UpdateLog (интерактивный отбор коммитов)..."
# -it — stdin/TTY из терминала git-операции; --interactive показывает список
# новых коммитов и спрашивает, какие добавить (невыбранные пишутся скрытыми).
# Нет TTY (pull из IDE/CI) или сбой — ничего не импортируем, коммиты будут
# предложены при следующем интерактивном запуске.
if docker exec -it "$CONTAINER" python manage.py sync_update_log --interactive; then
    echo "[post-merge] Готово"
else
    echo "[post-merge] Нет TTY или сбой — коммиты не импортированы (запустите:"
    echo "[post-merge]   docker exec -it dl_ai_web python manage.py sync_update_log --interactive)"
fi
# Не блокируем git-операцию при сбое синхронизации.
exit 0