#!/bin/bash
# Git pre-push hook — срабатывает перед git push.
# Синхронизирует таблицу UpdateLog с коммитами, которые будут отправлены.
#
# Работает на хосте (где есть git), подключается к Docker-контейнеру web,
# в котором теперь установлен git и примонтирован .git — sync_update_log
# читает git log прямо в контейнере (без /tmp-обмена между хостом и контейнером).

cd "$(git rev-parse --show-toplevel)"

# Проверяем, что Docker-контейнер запущен
if ! docker compose ps --status=running web 2>/dev/null | grep -q "dl_ai_web"; then
    echo "[pre-push] Docker-контейнер web не запущен — пропускаю синхронизацию UpdateLog"
    exit 0
fi

echo "[pre-push] Синхронизация UpdateLog с новыми коммитами..."
docker compose exec -T web python manage.py sync_update_log
echo "[pre-push] Готово"