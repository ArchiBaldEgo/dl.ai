.git
.gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env
.venv/
venv/
ENV/

# Env files (secrets)
.env
.env.*

# Editor
.vscode/
.idea/

# OS
.DS_Store

# Docker / compose
*.log

# Bot build artifacts
bot/node_modules/
bot/.cache/
bot/.puppeteer-cache/
bot/chrome*
bot/chromium*

# Non-runtime files — not needed in the web image (collectstatic rebuilds
# staticfiles in-container via the static_volume; doc/*.docx and *.md are not
# served; scripts/ and backups/ run on the host, not in the container).
staticfiles/
doc/
docs/
backups/
scripts/
test_db.sqlite3
*.md
Dockerfile
docker-compose.yml
.dockerignore
.github/

.claude/