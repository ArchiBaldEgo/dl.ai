.git
.gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env
.venv/
venv/
ENV/

# Env files (secrets)
.env
.env.*

# Editor
.vscode/
.idea/

# OS
.DS_Store

# Docker / compose
*.log

# Bot build artifacts
WebDeepseek/node_modules/
WebDeepseek/.cache/
WebDeepseek/.puppeteer-cache/
WebDeepseek/chrome*
WebDeepseek/chromium*
# Chrome profiles (session cookies) — bind-mounted at runtime via .:/app,
# not needed in the image; their files are permission-restricted and break
# the build-context sender (open ... permission denied).
**/worker/.chrome-profiles/
WebKimi/node_modules/
WebKimi/.cache/
WebKimi/.puppeteer-cache/
WebKimi/chrome*
WebKimi/chromium*

# Non-runtime files — not needed in the web image (collectstatic rebuilds
# staticfiles in-container via the static_volume; doc/*.docx and *.md are not
# served; scripts/ and backups/ run on the host, not in the container).
staticfiles/
doc/
docs/
backups/
scripts/
test_db.sqlite3
*.md
Dockerfile
docker-compose.yml
.dockerignore
.github/

.claude/