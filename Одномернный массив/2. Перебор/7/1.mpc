int __bits(8) x[10];
int __bits(8) sum_pol;
int __bits(8) sum_otr;
int __bits(8) abs;
int __bits(8) res;

void main() {
for (int i = 0; i < 10; i++) {
if (x[i] < 0) {
sum_otr += x[i];
}
}
for (i = 0; i < 10; i++) {
if (x[i] > 0) {
sum_pol += x[i];
}
}
if (sum_otr < 0) {
abs = -sum_otr;
} else {
abs = sum_otr;
}
if (abs != 0) {
res = sum_pol % abs;
} else {
res = 0;
}
}
