int __in __bits(8) x;
int __out __bits(8) res;

static int sum_pos = 0;
static int sum_abs_neg = 0;
static int count = 0;

void main() {
if (count < 10) {
if (x > 0) {
sum_pos += x;
} else if (x < 0) {
sum_abs_neg += -x; // ¦şôºû¹ şª¨ø¡ğªõû¹ışóş ¢ø¸ûğ
}
count++;
res = 0;
} else {
if (sum_abs_neg == 0) {
res = 0;
} else {
res = sum_pos % sum_abs_neg;
}
// Tñ¨ş¸ ôû ¸ûõôº¦•õóş òõúªş¨ğ
sum_pos = 0;
sum_abs_neg = 0;
count = 0;
}
}
