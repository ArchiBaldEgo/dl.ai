int __bits(8) x[10];
int __out __bits(8) res;

void main() {
int __bits(16) sum_positive = 0;
int __bits(16) sum_negative = 0;

for(int i = 0; i < 10; i++) {
if(x[i] > 0) {
sum_positive = sum_positive + x[i];
} else if(x[i] < 0) {
sum_negative = sum_negative + (-x[i]);
}
}

if(sum_negative != 0) {
res = sum_positive % sum_negative;
} else {
res = 0;
}
}
