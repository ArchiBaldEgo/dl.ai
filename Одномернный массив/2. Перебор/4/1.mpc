int __in __bits(8) x[10];

int __out __bits(8) result;

void main()
{
int __bits(8) sumPos;
int __bits(8) sumNeg;
int __bits(8) i;

sumPos = 0;
sumNeg = 0;

for (i = 0; i < 10; i = i + 1)
{
if (x[i] > 0)
{
sumPos = sumPos + x[i];
}
else
{
if (x[i] < 0)
{
sumNeg = sumNeg + (-x[i]);
}
}
}

result = sumPos % sumNeg;
}
