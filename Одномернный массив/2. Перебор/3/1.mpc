int __out __bits(8) result;

void main()
{
int __bits(8) A[10];
int __bits(8) sumPos;
int __bits(8) sumNeg;
int __bits(8) i;

sumPos = 0;
sumNeg = 0;

for (i = 0; i < 10; i = i + 1)
{
if (A[i] > 0)
{
sumPos = sumPos + A[i];
}
else
{
if (A[i] < 0)
{
sumNeg = sumNeg + (-A[i]);
}
}
}

result = sumPos % sumNeg;
}
