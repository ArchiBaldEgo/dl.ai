CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_HTTPONLY=
CSRF_USE_SESSIONS=

EXTERNAL_AUTH_DISABLE_PROXY=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

AUTH_TIMEOUT_MS=
ADRESS=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
PROXY=

RUNTIME_HTTP_PROXY=
RUNTIME_HTTPS_PROXY=
RUNTIME_NO_PROXY=

PUPPETEER_PROXY_SERVER=
PUPPETEER_PROXY_USERNAME=
PUPPETEER_PROXY_PASSWORD=

EXTERNAL_AUTH_API_URL=
EXTERNAL_SESSION_COOKIE_NAME=

EXTERNAL_AUTH_SKIP_PATHS=

# Redis cache. Обязательно для production (много Daphne/Gunicorn workers).
# Внутри Docker Compose используйте имя сервиса: redis://redis:6379/1
# Для локальной разработки без Docker: redis://127.0.0.1:6379/1
# Если не задано, Django fallback на LocMemCache (только dev/один процесс).
REDIS_URL=
REDIS_VOLUME_NAME=

CLIENT_ID=
SBER_SECRET=
HF_TOKEN=
# SC_TOKEN=
SC_TOKEN=
MIST_TOKEN=
GROQ_TOKEN=
DEEPSEEK_API_TOKEN=sk-

# Auto-restart the bot/ pool when Web DeepSeek is detected as down by the health check.
AI_WEB_DEEPSEEK_AUTORECOVERY=

# Auto-restart the Kimi bot pool when Web Kimi is detected as down by the health check.
AI_WEB_KIMI_AUTORECOVERY=
# ==================== Web Kimi bot pool (WebKimi/, loopback 3001) ====================
# Отдельный от DeepSeek пул. KIMI_* namespace — DeepSeek и Kimi делят один env_file,
# поэтому не-namespaced PORT/SERVICE_MODEL/BOT_USERNAME коллизировали бы.
# Вход в Kimi НЕ автоматизируется (телефон/WeChat/email): сессия сидируется вручную
# (запустить с KIMI_HEADLESS=false + дисплей, войти один раз — профиль сохранит куку).
KIMI_POOL_URL=http://localhost:3001
KIMI_PORT=3001
KIMI_MAX_BOT_COUNT=2
KIMI_RETRY_AFTER_SEC=3
KIMI_REQUEST_TIMEOUT_MS=300000
KIMI_SERVICE_MODEL=kimi
KIMI_HEADLESS=true
KIMI_VIEWPORT_W=800
KIMI_VIEWPORT_H=800
# Пустой → дефолт WebKimi/worker/.chrome-profiles. Для переживания ребилдов —
# задать persisted-путь (или монтировать volume на профиль-каталог).
KIMI_BOT_PROFILE_DIR=
# Прокси Kimi: пустой → fallback на общие PUPPETEER_PROXY_* (см. выше).
KIMI_BOT_PROXY=
KIMI_BOT_PROXY_USER=
KIMI_BOT_PROXY_PASS=
# debug-снимки auth-*.html/.png в WebKimi/worker/logs/ при неудаче (калибровка селекторов).
KIMI_AUTH_DEBUG=false
KIMI_AUTH_TIMEOUT_MS=45000

# Per-user rate limiting (sliding window). Defaults shown.
AI_RATE_LIMIT_ENABLED=
AI_WS_RATE_LIMIT=
AI_HTTP_RATE_LIMIT=
AI_RATE_LIMIT_WINDOW=
# Separate (higher) limit for read-only background polling endpoints
# (/ai/admin/arm/models/state/ and /ai/admin/arm/find-error/status/), so that
# watching an ARM run or the model-status page does not eat the action budget.
AI_HTTP_POLL_RATE_LIMIT=

# Set to 1 to disable the daily 04:00 MSK model-health scheduler (and the
# startup warm-up). Leave commented/0 in production.
# AI_DISABLE_HEALTH_SCHEDULER=0

# OpenRouter (бесплатные модели)
OPENROUTER_API_KEY=
SECURE_SSL_REDIRECT=

# Mail Bridge (ящик-приёмник для команд)
MAIL_BRIDGE_IMAP_HOST=
MAIL_BRIDGE_IMAP_PORT=
MAIL_BRIDGE_IMAP_USER=
MAIL_BRIDGE_IMAP_PASS=
MAIL_BRIDGE_SMTP_HOST=
MAIL_BRIDGE_SMTP_PORT=
MAIL_BRIDGE_SMTP_USER=
MAIL_BRIDGE_SMTP_PASS=
MAIL_BRIDGE_ALLOWED_SENDERS=
MAIL_BRIDGE_POLL=