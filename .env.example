# Redis cache. Обязательно для production (много Daphne/Gunicorn workers).
# Внутри Docker Compose используйте имя сервиса: redis://redis:6379/1
# Для локальной разработки без Docker: redis://127.0.0.1:6379/1
# Если не задано, Django fallback на LocMemCache (только dev/один процесс).
REDIS_URL=
REDIS_VOLUME_NAME=

CLIENT_ID=
SBER_SECRET=
HF_TOKEN=
# SC_TOKEN=
SC_TOKEN=
MIST_TOKEN=
GROQ_TOKEN=
DEEPSEEK_API_TOKEN=sk-

# Auto-restart the bot/ pool when Web DeepSeek is detected as down by the health check.
AI_WEB_DEEPSEEK_AUTORECOVERY=

# Per-user rate limiting (sliding window). Defaults shown.
AI_RATE_LIMIT_ENABLED=
AI_WS_RATE_LIMIT=
AI_HTTP_RATE_LIMIT=
AI_RATE_LIMIT_WINDOW=
# Separate (higher) limit for read-only background polling endpoints
# (/ai/admin/arm/models/state/ and /ai/admin/arm/find-error/status/), so that
# watching an ARM run or the model-status page does not eat the action budget.
AI_HTTP_POLL_RATE_LIMIT=

# Set to 1 to disable the daily 04:00 MSK model-health scheduler (and the
# startup warm-up). Leave commented/0 in production.
# AI_DISABLE_HEALTH_SCHEDULER=0

# OpenRouter (бесплатные модели)
OPENROUTER_API_KEY=
SECURE_SSL_REDIRECT=

# Mail Bridge (ящик-приёмник для команд)
MAIL_BRIDGE_IMAP_HOST=
MAIL_BRIDGE_IMAP_PORT=
MAIL_BRIDGE_IMAP_USER=
MAIL_BRIDGE_IMAP_PASS=
MAIL_BRIDGE_SMTP_HOST=
MAIL_BRIDGE_SMTP_PORT=
MAIL_BRIDGE_SMTP_USER=
MAIL_BRIDGE_SMTP_PASS=
MAIL_BRIDGE_ALLOWED_SENDERS=
MAIL_BRIDGE_POLL=