# Bot pool (Web DeepSeek) configuration — эталон для bot/.env.
# Читается docker-compose (env_file: ./bot/.env) и bot/api/config.js.
# Скопируйте в bot/.env и заполните BOT_USERNAME/BOT_PASSWORD.

# --- API server ---
PORT=3000
# Количество одновременных Puppeteer-воркеров (ботов).
MAX_BOT_COUNT=3
# Retry-After (сек) для 429/503 ответов /api/send.
RETRY_AFTER_SEC=3

# --- Таймауты ---
# Серверный таймаут /api/send и /v1/chat/completions (мс).
# ВАЖНО: должен быть >= 300000 (worker waitLastOuterHtmlStable = 300000 мс).
# Меньшее значение режет длинные ответы DeepThink → HTTP 500 → retry в Django.
# (server.js дополнительно делает Math.max(REQUEST_TIMEOUT_MS, 300000) — защита
# от рассинхрона, но всё равно держите здесь 300000.)
REQUEST_TIMEOUT_MS=300000

# --- Worker ---
SERVICE_MODEL=deepseek
HEADLESS=true
# Путь к Chromium, если нужно переопределить bundled (иначе пусто).
CHROME_PATH=
VIEWPORT_W=800
VIEWPORT_H=800

# --- DeepSeek account ---
BOT_USERNAME=
BOT_PASSWORD=

# --- Диагностика ---
# AUTH_DEBUG=1 → сохранять артефакты логина в bot/worker/logs/auth-*.html/png
# (полезно, когда сломались селекторы авторизации chat.deepseek.com).
AUTH_DEBUG=0

# --- Прокси (опционально) ---
# docker-compose маппит PUPPETEER_PROXY_* → BOT_PROXY*.
# BOT_PROXY=http://host:port
# BOT_PROXY_USER=
# BOT_PROXY_PASS=
# PUPPETEER_PROXY_SERVER=
# PUPPETEER_PROXY_USERNAME=
# PUPPETEER_PROXY_PASSWORD=